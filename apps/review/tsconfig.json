{
	"compilerOptions": {
		"target": "es2024",
		"module": "preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"types": ["node"],
		"lib": ["es2024", "DOM", "DOM.Iterable"],
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["*.ts", "src/**/*.ts", "src/**/*.svelte", "tests"]
}
